# Safe default: FFmpeg is always available as the fallback renderer.
VIDEO_RENDERER=ffmpeg

# Optional code-driven OpenCut project
OPENCUT_PROJECT=
OPENCUT_CWD=.
OPENCUT_TIMEOUT_SEC=1800

# Optional Remotion project
REMOTION_PROJECT_DIR=
REMOTION_COMPOSITION=FactoryVideo
REMOTION_TIMEOUT_SEC=1800

# Optional local ComfyUI server
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CLIENT_ID=video-factory
COMFYUI_TIMEOUT_SEC=1800
COMFYUI_POLL_SEC=2

# Video output
VIDEO_WIDTH=720
VIDEO_HEIGHT=1280
VIDEO_FPS=24
VIDEO_MAX_FRAMES=12
