# ============================================================
# MultiPlatformAIVideoGenerator - Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to Git.
# ============================================================

# ---------- Core AI Services (required for video generation) ----------
GROQ_API_KEY=your_groq_api_key_here

# ---------- Image generation via OpenRouter ----------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2
OPENROUTER_IMAGE_ASPECT_RATIO=9:16

# Legacy keys (not used by the current image pipeline)
# GEMINI_API_KEY=
# TOGETHER_API_KEY=

# ---------- YouTube Data API v3 (OAuth 2.0) ----------
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=token.json
YOUTUBE_PRIVACY_STATUS=public
# Options: public | private | unlisted

# ---------- TikTok Content Posting API ----------
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
# Options: PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | SELF_ONLY | FOLLOWER_OF_CREATOR

# ---------- Facebook Graph API (Reels / Page) ----------
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token
FACEBOOK_API_VERSION=v21.0

# ---------- Optional / Future platforms ----------
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=
# LINKEDIN_ACCESS_TOKEN=
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=

# ---------- Runtime settings ----------
DEFAULT_VIDEO_STYLE=educational
DEFAULT_TARGET_AUDIENCE=general
DEFAULT_CTA=Follow for more!
OUTPUT_DIR=output
LOG_LEVEL=INFO
