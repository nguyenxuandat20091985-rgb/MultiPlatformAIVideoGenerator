# Remote worker environment — copy to worker.env and fill values locally.
WORKER_MODE=1
PORT=8000
WORKER_MAX_CONCURRENCY=1

# Public address of this worker. Example: http://203.0.113.10:8000
PUBLIC_BASE_URL=http://YOUR_WORKER_IP:8000

# Shared secret between Render API and worker. Generate your own long random value.
WORKER_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN
VIDEO_WORKER_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

# AI keys stay on the worker; never commit this file.
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional publisher credentials if the worker publishes directly.
TIKTOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
